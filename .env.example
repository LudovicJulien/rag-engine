# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=rag-collection

# ── Embedding model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_BATCH_SIZE=32

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── LLM ───────────────────────────────────────────────────────────────────────
# Choix du provider : "ollama" (local, gratuit) ou "openai" (cloud, payant)
LLM_PROVIDER=ollama

# Ollama — tourne sur Windows, accessible depuis WSL2 via localhost
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# OpenAI — ignoré si LLM_PROVIDER=ollama
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=5
SCORE_THRESHOLD=0.7

LOG_LEVEL=INFO
